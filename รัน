-- 🛡️ 1. ระบบป้องกันอัตโนมัติ (Anti-Ban & Anti-AFK)
-- ==========================================
local function InitProtections()
    -- [Anti-AFK] กันปลิวเวลานอน ปล่อยจอทิ้งไว้ข้ามคืน
    LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
    
    -- [Anti-Kick] บล็อกการเตะจากฝั่ง Client
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod():lower() == "kick" then 
                print("[ArosHUB]: 🛡️ บล็อกการพยายามเตะ/แบน คุณออกจากเกม!")
                return nil 
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)

    -- แจ้งเตือนสิทธิพิเศษเมื่อเปิดใช้งาน
    StarterGui:SetCore("SendNotification", {
        Title = "⚡ AROSHUB SYSTEM",
        Text = "คุณได้รับสิทธิพิเศษในการ กันแบน/กันปลิว แบบ 100% แล้ว!",
        Duration = 8
    })
end
InitProtections()

