-- 🛡️ ฟังก์ชันระบบอมตะ God Mode & ยืนท่า T-Pose
local function ToggleGodMode()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if isGodMode then
        if hum then
            hum.MaxHealth = math.huge
            hum.Health = math.huge
            -- ลูปรักษาระดับเลือดอนันต์
            godModeConnection = RunService.RenderStepped:Connect(function()
                if hum.Parent then hum.Health = hum.MaxHealth end
            end)
            -- บังคับหยุดแอนิเมชันเดิมเพื่อทำ T-Pose
            local anim = hum:FindFirstChildOfClass("Animator")
            if anim then for _, track in ipairs(anim:GetPlayingAnimationTracks()) do track:Stop() end end
            if char:FindFirstChild("Animate") then originalAnimate = char.Animate:Clone() char.Animate:Destroy() end
        end
    else
        -- ปิดใช้งาน คืนค่าตัวละครปกติ
        if godModeConnection then godModeConnection:Disconnect() godModeConnection = nil end
        if hum then hum.MaxHealth = 100 hum.Health = 100 end
        if originalAnimate and char and not char:FindFirstChild("Animate") then originalAnimate.Parent = char end
    end
end

GodModeBtn.MouseButton1Click:Connect(function()
