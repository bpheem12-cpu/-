    GodModeBtn.Text = isGodMode and "🛡️ GOD MODE: ON" or "🛡️ GOD MODE: OFF"
    GodModeBtn.BackgroundColor3 = isGodMode and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(255, 55, 55)
    ToggleGodMode()
end)

